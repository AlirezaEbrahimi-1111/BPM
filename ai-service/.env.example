# کپی کنید به .env و مقادیرِ واقعی را جایگزین کنید — .env هرگز کامیت نمی‌شود

# باید دقیقاً برابرِ ai_service_secret در config/config.php باشد
AI_SERVICE_SECRET=REPLACE_ME_BEFORE_DEPLOY

BPM_BASE_URL=http://localhost:8080

OPENAI_API_KEY=sk-...
# ارائه‌دهنده‌یِ فعلی: DeepSeek (سازگار با API فرمتِ OpenAI) — بندِ ۲۲.۱ سند
# اگر ارائه‌دهنده عوض شود (مثلاً OpenAIِ رسمی)، این خط را بردارید یا مقدارش را عوض کنید
OPENAI_BASE_URL=https://api.deepseek.com
