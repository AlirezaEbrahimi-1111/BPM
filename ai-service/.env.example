# کپی کنید به .env و مقادیر واقعی را جایگزین کنید — .env هرگز کامیت نمی‌شود

# باید دقیقا برابر ai_service_secret در config/config.php باشد
AI_SERVICE_SECRET=REPLACE_ME_BEFORE_DEPLOY

BPM_BASE_URL=http://localhost:8080

OPENAI_API_KEY=sk-...
# یک Gateway سازگار با فرمت API OpenAI — تا الان AvalAI و GapGPT امتحان
# شدن (بند ۲۲.۱ سند). برای سوییچ ارائه‌دهنده، فقط همین سه مقدار عوض بشه
OPENAI_BASE_URL=https://api.gapgpt.app/v1
OPENAI_MODEL=gapgpt-qwen-3.6
