# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# جلوگیریِ سراسری از نمایشِ فهرستِ فایل‌ها (Directory Listing) در پوشه‌هایی
# که فایلِ index ندارن — طبقِ استانداردِ امنیتیِ وب، صرفِ نظر از اینکه کدوم
# vhost/سرور این فایل‌ها رو سرو می‌کنه (چون این‌جا، نه توی تنظیماتِ Apache،
# نوشته شده، خودکار با هر دیپلوی به همه‌جا اعمال می‌شه).
Options -Indexes

# سقف حجم آپلود PHP (پیش‌فرض سرور معمولا خیلی کمتر از حد مجاز خودِ برنامه‌ست —
# مثلا فایل ۸ مگابایتی با ۴۰۰ رد می‌شد چون PHP قبل از رسیدن به کد ما فایل رو
# دور می‌ریخت). چند مگابایت بیشتر از بزرگ‌ترین سقفِ upload-attachment.php
# (ویدیوی mp4/mov = ۵۰ مگابایت؛ بقیه‌ی فایل‌ها همان ۲۰ مگابایت)، تا حاشیه‌ی امن
# داشته باشیم. max_input_time: مهلتِ دریافتِ بدنه‌ی درخواست — ویدیوی ۵۰ مگابایتی
# با اینترنتِ همراه در ۶۰ ثانیه‌ی پیش‌فرض نمی‌رسد.
<IfModule mod_php7.c>
    php_value upload_max_filesize 55M
    php_value post_max_size 56M
    php_value max_input_time 600
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 55M
    php_value post_max_size 56M
    php_value max_input_time 600
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 55M
    php_value post_max_size 56M
    php_value max_input_time 600
</IfModule>

# .htaccess
RewriteEngine On

# فعال فقط روی هاست واقعی
# استثنایِ مسیرِ چالشِ certbot — بدونِ این، تمدیدِ خودکارِ گواهیِ SSL
# (که از همین webroot استفاده می‌کنه) با ریدایرکتِ اجباری به https شکست
# می‌خورد. این خط قبلاً فقط مستقیم رویِ سرور اضافه شده بود (نه اینجا) —
# همین ناهماهنگی باعث شد چند دیپلویِ بعدی روی سرور fast-forward نشن.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} !^(localhost|bpm\.local) [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# دامنه‌ی اصلی itmalek.com (نه bpm.itmalek.com): صفحه‌ی اول = صفحه‌ی خوش‌آمد
# استاتیک (landing.html)؛ هر مسیر دیگر به همان مسیر روی bpm.itmalek.com
# فرستاده می‌شود تا لینک‌های قدیمی (مثلا itmalek.com/pages/...) خراب نشوند.
RewriteCond %{HTTP_HOST} ^(www\.)?itmalek\.com$ [NC]
RewriteRule ^$ /landing.html [L]
RewriteCond %{HTTP_HOST} ^(www\.)?itmalek\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(landing\.html|assets/landing/|assets/fonts/|\.well-known/)
RewriteRule ^(.*)$ https://bpm.itmalek.com/$1 [R=301,L]

# یا این روش:
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

RewriteEngine On

# فقط اگر مسیر دقیقاً /pages باشه
RewriteCond %{REQUEST_URI} ^/pages/?$ 
RewriteRule ^.*$ /access-denied.php [R=302,L]