# فایلِ سرویسِ systemd برای crm-service.
# روی سرور کپی شود به:  /etc/systemd/system/bmp-crm.service
# سپس:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bmp-crm
#   sudo systemctl status bmp-crm
#   journalctl -u bmp-crm -f        # دیدنِ لاگِ زنده

[Unit]
Description=BPM CRM service (Go)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bmp-crm
ExecStart=/opt/bmp-crm/crm-service
Environment=CRM_CONFIG=/opt/bmp-crm/config.json
Restart=on-failure
RestartSec=3

# ── سخت‌سازیِ سبک (اگر جایی مشکل ساخت، این چهار خط را کامنت کن) ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bmp-crm

[Install]
WantedBy=multi-user.target
