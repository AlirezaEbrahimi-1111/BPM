[Unit]
Description=go-api — بازنویسی تدریجی api/ به Go (Strangler Fig)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bpm-go-api
ExecStart=/opt/bpm-go-api/go-api
Restart=on-failure
RestartSec=5

# سخت‌سازی حافظه — این سرویس نباید هیچ‌وقت باعث OOM دیتابیس شود.
# (سابقهٔ OOM روی همین باکس: project_prod_outage_20260907_oom)
OOMScoreAdjust=500
MemoryMax=256M

# کمترین دسترسی ممکن
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/bpm-go-api

[Install]
WantedBy=multi-user.target
