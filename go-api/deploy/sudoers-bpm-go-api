# /etc/sudoers.d/bpm-go-api
#
# به کاربر دیپلوی اجازه می‌دهد فقط همین یک اسکریپت root-owned را بدون رمز
# اجرا کند. deploy نمی‌تواند خود اسکریپت را تغییر دهد، پس محدود و امن است.
# اگر نام کاربر SSH دیپلوی «deploy» نیست، عوضش کن.
#
# نصب:
#   sudo install -m 0440 sudoers-bpm-go-api /etc/sudoers.d/bpm-go-api
#   sudo visudo -c        # باید «parsed OK» بدهد
deploy ALL=(root) NOPASSWD: /opt/bpm-go-api/apply-go-api.sh
